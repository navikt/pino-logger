{
    "name": "pino-logger-root",
    "private": true,
    "license": "MIT",
    "type": "module",
    "packageManager": "yarn@4.18.0",
    "workspaces": [
        "libs/pino-logger",
        "libs/next-logger"
    ],
    "engines": {
        "node": "24"
    },
    "scripts": {
        "build": "yarn workspaces foreach -At run build",
        "test": "yarn workspaces foreach -A run test",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "next:patch": "yarn workspaces foreach -A --no-private version patch -i",
        "next:minor": "yarn workspaces foreach -A --no-private version minor -i"
    },
    "devDependencies": {
        "@navikt/tsm-oxfmt": "^0.0.11",
        "@navikt/tsm-oxlint": "^0.0.7",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.79.0",
        "oxlint-tsgolint": "^7.0.2001",
        "rimraf": "^6.1.3"
    }
}
